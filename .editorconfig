root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# Visual Studio が /utf-8 なしでも正しく読めるように，C のソースは BOM 付き UTF-8 にする
[*.{c,h}]
charset = utf-8-bom
indent_style = space
indent_size = 4

[*.{json,cmake,yml,yaml}]
indent_style = space
indent_size = 2

[CMakeLists.txt]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
