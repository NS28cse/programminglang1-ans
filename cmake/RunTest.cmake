# 1 つのテストケースを実行して結果を比較する（CTest から cmake -P で呼ばれる）
#   -DPROGRAM=実行ファイル -DPROJECT_DIR=テストのあるフォルダ（tests/ を持つ） -DCASE=ケース名 -DWORK_DIR=作業フォルダ
#   -DDATA_DIR=フォルダ（任意。省略時は PROJECT_DIR）: データファイル（input.txt など）をコピーする元のプロジェクトフォルダ
#     （書き換えた版のテストは PROJECT_DIR が <プロジェクト>/variants なので，プロジェクトフォルダを別に渡す）
#   -DSAVE_DIR=フォルダ（任意）: 実際の出力を tests/ と同じ形式で保存する（ta-results ブランチの results/。
#     <ケース>.out は必ず，.err は標準エラー出力があるとき，.code は 0 以外のとき，
#     .files/ は実行で作られた・変わったファイルと，期待値の <ケース>.files/ にあるファイル）
# テストのファイル形式は CONTRIBUTING.md の「自動テスト」を参照
#
# ルートの CMakeLists.txt は，SOFTPRAC_DATA_RULE_ONLY を ON にしてこのファイルを include し，
# データファイルの規則（softprac_is_data_file）だけを読み込む（ビルドとテストで同じ規則を使うため）
cmake_minimum_required(VERSION 3.21)

# プロジェクトフォルダのファイルのうち，実行に使うデータファイル（input.txt など）かどうか。
# ソース・設定・README と，コンパイラを直接使って作った a.out・*.exe など，
# 第10回のプログラムが書き出すファイル（IDE やコマンドで実行するとプロジェクトフォルダに残る）は除く
function(softprac_is_data_file path result)
  get_filename_component(fname "${path}" NAME)
  if(fname MATCHES "(\\.c|\\.h|^CMakeLists\\.txt|^README.*|^run\\.args|^a\\.out|\\.exe|\\.obj|\\.o|\\.pdb|\\.ilk)$"
     OR path MATCHES "/week10/(WriteSquares/squares.*\\.txt|WriteText/scores\\.txt|NumberFormats/numbers\\..*|Binary/bytes\\.bin)$")
    set(${result} FALSE PARENT_SCOPE)
  else()
    set(${result} TRUE PARENT_SCOPE)
  endif()
endfunction()

if(SOFTPRAC_DATA_RULE_ONLY)
  return()
endif()

foreach(var PROGRAM PROJECT_DIR CASE WORK_DIR)
  if(NOT DEFINED ${var})
    message(FATAL_ERROR "${var} が指定されていません")
  endif()
endforeach()
if(NOT DATA_DIR)
  set(DATA_DIR "${PROJECT_DIR}")
endif()

set(prefix "${PROJECT_DIR}/tests/${CASE}")

# 作業フォルダを作り直し，プロジェクトフォルダのデータファイル（ビルドで実行ファイルのフォルダへコピーするものと同じ）をコピーする
file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}")
file(GLOB data_files LIST_DIRECTORIES false "${DATA_DIR}/*")
foreach(f IN LISTS data_files)
  softprac_is_data_file("${f}" is_data)
  if(is_data)
    file(COPY "${f}" DESTINATION "${WORK_DIR}")
  endif()
endforeach()
# ケース専用のファイル（<ケース>.setup/ 以下）も作業フォルダへコピーする
# 同じ名前のデータファイルは置き換える（file(COPY) は時刻が同じファイルを上書きしないので，先に消す）
if(IS_DIRECTORY "${prefix}.setup")
  file(GLOB setup_files LIST_DIRECTORIES true "${prefix}.setup/*")
  foreach(f IN LISTS setup_files)
    get_filename_component(fname "${f}" NAME)
    file(REMOVE_RECURSE "${WORK_DIR}/${fname}")
  endforeach()
  file(COPY ${setup_files} DESTINATION "${WORK_DIR}")
endif()

# 実行前の作業フォルダのファイルとハッシュ（実行で作られた・変わったファイルを保存するため）
set(before_hashes "")
if(SAVE_DIR)
  file(GLOB_RECURSE before_files RELATIVE "${WORK_DIR}" "${WORK_DIR}/*")
  foreach(rel IN LISTS before_files)
    file(SHA256 "${WORK_DIR}/${rel}" h)
    list(APPEND before_hashes "${rel}=${h}")
  endforeach()
endif()

# 引数（1 行 1 引数，空行は空文字列）。空の引数も渡せるように bracket 引数で組み立てる
set(args_shown "")   # 失敗したときに表示する引数（[ ] で 1 個ずつ囲む）
set(command_code "execute_process(COMMAND [==[${PROGRAM}]==]")
if(EXISTS "${prefix}.args")
  file(READ "${prefix}.args" args_text)
  if(NOT args_text STREQUAL "")
    string(REPLACE "\r" "" args_text "${args_text}")
    string(REGEX REPLACE "\n$" "" args_text "${args_text}")
    if(args_text STREQUAL "")
      # 空行 1 行だけのファイル = 空文字列の引数 1 つ
      string(APPEND command_code " [==[]==]")
      set(args_shown " []")
    else()
      string(REPLACE ";" "\\;" args_text "${args_text}")
      string(REPLACE "\n" ";" args_list "${args_text}")
      foreach(a IN LISTS args_list)
        string(APPEND command_code " [==[${a}]==]")
        string(APPEND args_shown " [${a}]")
      endforeach()
    endif()
  endif()
endif()
string(APPEND command_code "\n  WORKING_DIRECTORY [==[${WORK_DIR}]==]")
if(EXISTS "${prefix}.in")
  string(APPEND command_code "\n  INPUT_FILE [==[${prefix}.in]==]")
endif()
string(APPEND command_code "\n  OUTPUT_VARIABLE actual_out\n  ERROR_VARIABLE actual_err\n  RESULT_VARIABLE actual_code\n  TIMEOUT 20)")
cmake_language(EVAL CODE "${command_code}")

# 実際の出力を保存する（比較の前に保存するので，失敗したケースも残る）
if(SAVE_DIR)
  set(save "${SAVE_DIR}/${CASE}")
  file(REMOVE "${save}.out" "${save}.err" "${save}.code")
  file(REMOVE_RECURSE "${save}.files")
  file(MAKE_DIRECTORY "${SAVE_DIR}")
  file(WRITE "${save}.out" "${actual_out}")
  if(NOT actual_err STREQUAL "")
    file(WRITE "${save}.err" "${actual_err}")
  endif()
  if(NOT "${actual_code}" STREQUAL "0")
    file(WRITE "${save}.code" "${actual_code}\n")
  endif()
  # 期待値で確かめるファイル（<ケース>.files/）は，内容が実行前と同じでも保存する
  set(checked_files "")
  if(IS_DIRECTORY "${prefix}.files")
    file(GLOB_RECURSE checked_files RELATIVE "${prefix}.files" "${prefix}.files/*")
  endif()
  file(GLOB_RECURSE after_files RELATIVE "${WORK_DIR}" "${WORK_DIR}/*")
  foreach(rel IN LISTS after_files)
    file(SHA256 "${WORK_DIR}/${rel}" h)
    if(NOT "${rel}=${h}" IN_LIST before_hashes OR rel IN_LIST checked_files)
      get_filename_component(sub "${rel}" DIRECTORY)
      file(COPY "${WORK_DIR}/${rel}" DESTINATION "${save}.files/${sub}")
    endif()
  endforeach()
endif()

set(failed FALSE)
set(report "")   # 失敗の説明（最後にまとめて表示する）

function(normalize var)
  string(REPLACE "\r\n" "\n" v "${${var}}")
  set(${var} "${v}" PARENT_SCOPE)
endfunction()

# 1 行を，末尾の空白やタブが見えるように [ ] で囲んで返す
function(visible_line line var)
  string(REPLACE "\t" "\\t" line "${line}")
  string(REPLACE "\r" "\\r" line "${line}")
  set(${var} "[${line}]" PARENT_SCOPE)
endfunction()

# 期待と実際の文字列を比べ，違えば最初に違う行と全体を report に加える
function(compare_text what expected actual)
  if(actual STREQUAL expected)
    return()
  endif()
  # 1 行ずつ比べて，最初に違う行を探す（行は \n まで。; を含む行もあるのでリストにしない）
  set(e "${expected}")
  set(a "${actual}")
  set(line_no 1)
  while(TRUE)
    string(FIND "${e}" "\n" ei)
    string(FIND "${a}" "\n" ai)
    if(ei EQUAL -1)
      set(el "${e}")
    else()
      string(SUBSTRING "${e}" 0 ${ei} el)
    endif()
    if(ai EQUAL -1)
      set(al "${a}")
    else()
      string(SUBSTRING "${a}" 0 ${ai} al)
    endif()
    set(e_last FALSE)
    set(a_last FALSE)
    if(ei EQUAL -1)
      set(e_last TRUE)
    endif()
    if(ai EQUAL -1)
      set(a_last TRUE)
    endif()
    if(NOT el STREQUAL al OR NOT e_last STREQUAL a_last OR e_last)
      break()
    endif()
    math(EXPR ei "${ei} + 1")
    math(EXPR ai "${ai} + 1")
    string(SUBSTRING "${e}" ${ei} -1 e)
    string(SUBSTRING "${a}" ${ai} -1 a)
    math(EXPR line_no "${line_no} + 1")
  endwhile()

  set(msg "[NG] ${what}が一致しません（最初に違うのは ${line_no} 行目）\n")
  if(e STREQUAL "" AND NOT a STREQUAL "")
    visible_line("${al}" av)
    string(APPEND msg "  期待: （ここで終わり）\n  実際: ${av}    ← 期待より行が多い\n")
  elseif(a STREQUAL "" AND NOT e STREQUAL "")
    visible_line("${el}" ev)
    string(APPEND msg "  期待: ${ev}\n  実際: （ここで終わり）    ← 期待より行が少ない\n")
  elseif(el STREQUAL al)
    # 行の内容は同じで，行末の改行だけが違う（最後の行）
    if(ei EQUAL -1)
      string(APPEND msg "  最後の行の後の改行: 期待はなし，実際はあり\n")
    else()
      string(APPEND msg "  最後の行の後の改行: 期待はあり，実際はなし（printf の最後の \\n を確かめる）\n")
    endif()
  else()
    visible_line("${el}" ev)
    visible_line("${al}" av)
    string(APPEND msg "  期待: ${ev}\n  実際: ${av}    （[ ] の中が行の内容。末尾の空白も含む）\n")
  endif()
  foreach(side 期待 実際)
    if(side STREQUAL "期待")
      set(t "${expected}")
    else()
      set(t "${actual}")
    endif()
    string(APPEND msg "----- ${side}（全体） -----\n${t}")
    if(t STREQUAL "")
      string(APPEND msg "（空）\n")
    elseif(NOT t MATCHES "\n$")
      string(APPEND msg "\n（最後の行の後に改行なし）\n")
    endif()
  endforeach()
  string(APPEND msg "----------------\n")
  set(report "${report}${msg}" PARENT_SCOPE)
  set(failed TRUE PARENT_SCOPE)
endfunction()

# 終了コード
set(expected_code 0)
if(EXISTS "${prefix}.code")
  file(STRINGS "${prefix}.code" expected_code LIMIT_COUNT 1)
  string(STRIP "${expected_code}" expected_code)
endif()
if(NOT "${actual_code}" STREQUAL "${expected_code}")
  string(APPEND report "[NG] 終了コード: 期待 ${expected_code}，実際 ${actual_code}\n")
  set(failed TRUE)
endif()

# 標準出力
file(READ "${prefix}.out" expected_out)
normalize(expected_out)
normalize(actual_out)
compare_text("標準出力" "${expected_out}" "${actual_out}")

# 標準エラー出力（任意）
if(EXISTS "${prefix}.err")
  file(READ "${prefix}.err" expected_err)
  normalize(expected_err)
  normalize(actual_err)
  compare_text("標準エラー出力" "${expected_err}" "${actual_err}")
endif()

# 実行後のファイル（.bin はバイト単位，それ以外は改行コードを無視して比較）
if(IS_DIRECTORY "${prefix}.files")
  file(GLOB_RECURSE expected_files RELATIVE "${prefix}.files" "${prefix}.files/*")
  foreach(rel IN LISTS expected_files)
    set(actual_path "${WORK_DIR}/${rel}")
    if(NOT EXISTS "${actual_path}")
      string(APPEND report "[NG] ファイル ${rel} が作られていません\n")
      set(failed TRUE)
      continue()
    endif()
    if(rel MATCHES "\\.bin$")
      file(SHA256 "${prefix}.files/${rel}" h1)
      file(SHA256 "${actual_path}" h2)
      if(NOT h1 STREQUAL h2)
        file(READ "${prefix}.files/${rel}" ehex HEX)
        file(READ "${actual_path}" hex HEX)
        string(APPEND report "[NG] ファイル ${rel} の内容が一致しません（16 進。期待: ${ehex}，実際: ${hex}）\n")
        set(failed TRUE)
      endif()
    else()
      file(READ "${prefix}.files/${rel}" e)
      file(READ "${actual_path}" a)
      normalize(e)
      normalize(a)
      compare_text("ファイル ${rel} の内容" "${e}" "${a}")
    endif()
  endforeach()
endif()

if(failed)
  # どのケースか（引数・標準入力・事前に置くファイル）を先に示す
  get_filename_component(tests_dir "${prefix}" DIRECTORY)
  set(head "===== ケース ${CASE}（${tests_dir}/） =====\n")
  if(args_shown STREQUAL "")
    string(APPEND head "引数: なし\n")
  else()
    string(APPEND head "引数:${args_shown}    （[ ] で 1 個ずつ囲む）\n")
  endif()
  if(EXISTS "${prefix}.in")
    file(READ "${prefix}.in" input_text)
    normalize(input_text)
    string(LENGTH "${input_text}" input_len)
    if(input_len GREATER 400)
      string(SUBSTRING "${input_text}" 0 400 input_text)
      string(APPEND input_text "…（以下略）\n")
    endif()
    string(APPEND head "標準入力（${CASE}.in）:\n${input_text}")
    if(input_text STREQUAL "")
      string(APPEND head "（空。すぐに EOF）\n")
    elseif(NOT input_text MATCHES "\n$")
      string(APPEND head "\n（最後の行の後に改行なし）\n")
    endif()
  else()
    string(APPEND head "標準入力: なし\n")
  endif()
  if(IS_DIRECTORY "${prefix}.setup")
    file(GLOB_RECURSE setup_rel RELATIVE "${prefix}.setup" "${prefix}.setup/*")
    string(REPLACE ";" "，" setup_rel "${setup_rel}")
    string(APPEND head "事前に置くファイル（${CASE}.setup/）: ${setup_rel}\n")
  endif()
  if(NOT actual_err STREQUAL "" AND NOT EXISTS "${prefix}.err")
    string(APPEND report "----- 標準エラー出力（参考） -----\n${actual_err}")
  endif()
  message("${head}${report}")
  # 失敗を ctest に伝える（CMake 3.29 以降は余分な「CMake Error at ...」を出さずに終える）
  if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.29)
    message("テスト ${CASE} に失敗しました")
    cmake_language(EXIT 1)
  endif()
  message(FATAL_ERROR "テスト ${CASE} に失敗しました")
endif()
